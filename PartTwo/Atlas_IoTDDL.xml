					<Libraries>wiringPi.h</Libraries>
					<ADC_Number>1</ADC_Number>
					<ADC>
						<ADC_1>
							<Type>ADS1115</Type>
							<Channel>0</Channel>
							<ADC_Output>adsRead0</ADC_Output>
						</ADC_1>
					</ADC>
				</Service_1>
				<Number_Services>1</Number_Services>
			</Services>
			<UnboundedService>
				<Number_UnboundedServices>0</Number_UnboundedServices>
			</UnboundedService>
