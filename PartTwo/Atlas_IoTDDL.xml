					<Service_InputDescriptions></Service_InputDescriptions>
					<Library_Number>1</Library_Number>
					<Libraries>wiringPi.h</Libraries>
					<ADC_Number>0</ADC_Number>
				</Service_1>
				<Number_Services>1</Number_Services>
			</Services>
