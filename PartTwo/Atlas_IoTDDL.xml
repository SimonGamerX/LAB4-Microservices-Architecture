		<!-- Entity 1: Ambient Light Sensor (ADS1115 ADC CH0) -->
		<Entity_1>
			<Descriptive_Metadata>
				<ID>Entity_LightSensor</ID>
				<Name>LightSensor</Name>
				<Owner>iotpj</Owner>
				<Vendor>LDR</Vendor>
				<Category>Hardware</Category>
				<Type>Sensor</Type>
				<Description>Measures ambient light intensity via ADS1115 Channel 0</Description>
			</Descriptive_Metadata>
			<Services>
				<Service_1>
					<Name>Read_Light_Level</Name>
					<AppCategory>Sensing</AppCategory>
					<Type>Report</Type>
					<Keywords>Light,Sensor,ADC,LDR</Keywords>
					<Description>Reads ambient light level percentage from ADS1115 ADC Channel 0</Description>
					<Contextual_Constraints>
						<Time_Window>10seconds</Time_Window>
						<Usage_Mode></Usage_Mode>
						<Concurrent></Concurrent>
					</Contextual_Constraints>
					<Temporal_Constraints>
						<Working>
							<StartTime>00:00:00</StartTime>
							<EndTime>23:59:59</EndTime>
						</Working>
						<Callable>
							<StartTime>00:00:00</StartTime>
							<EndTime>23:59:59</EndTime>
						</Callable>
					</Temporal_Constraints>
					<OutputDescription>value</OutputDescription>
					<OutputType>int</OutputType>
					<Service_Formula><![CDATA[
// Maps 16-bit ADS1115 reading (0-65535) on CH0 to percentage (0-100)
int pct = (adsRead0 * 100) / 65535;
value = (pct < 0) ? 0 : ((pct > 100) ? 100 : pct);
]]></Service_Formula>
					<Service_NumberInputs>0</Service_NumberInputs>
					<Service_InputTypes></Service_InputTypes>
					<Service_InputDescriptions></Service_InputDescriptions>
