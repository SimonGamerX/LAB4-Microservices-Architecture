				<Number_Relationships>0</Number_Relationships>
			</Relationships>
		</Entity_1>

		<!-- Entity 2: Thermostat Dial (Rotary Encoder on GPIO 20 & 21) -->
		<Entity_2>
			<Descriptive_Metadata>
				<ID>Entity_TempSensor</ID>
				<Name>TempSensor</Name>
				<Owner>iotpj</Owner>
				<Vendor>RotaryEncoder</Vendor>
				<Category>Hardware</Category>
				<Type>Sensor</Type>
				<Description>Reads simulated thermostat temperature dial via Rotary Encoder on GPIO 20 and 21</Description>
			</Descriptive_Metadata>
			<Services>
				<Service_1>
					<Name>Read_Temperature</Name>
					<AppCategory>Sensing</AppCategory>
					<Type>Report</Type>
					<Keywords>Temperature,Sensor,Thermostat,RotaryEncoder,GPIO</Keywords>
					<Description>Reads simulated thermostat dial temperature in Celsius from Rotary Encoder</Description>
					<Contextual_Constraints>
						<Time_Window>10seconds</Time_Window>
						<Usage_Mode></Usage_Mode>
						<Concurrent></Concurrent>
					</Contextual_Constraints>
					<Temporal_Constraints>
						<Working>
							<StartTime>00:00:00</StartTime>
							<EndTime>23:59:59</EndTime>
						</Working>
						<Callable>
							<StartTime>00:00:00</StartTime>
							<EndTime>23:59:59</EndTime>
						</Callable>
					</Temporal_Constraints>
					<OutputDescription>value</OutputDescription>
					<OutputType>int</OutputType>
					<Service_Formula><![CDATA[
int clkPin = 20;
int dtPin = 21;
wiringPiSetupGpio();
pinMode(clkPin, INPUT);
pinMode(dtPin, INPUT);
static int currentTemp = 24;
static int lastClk = HIGH;
int clkState = digitalRead(clkPin);
if (clkState != lastClk && clkState == LOW) {
    if (digitalRead(dtPin) != clkState) {
        if (currentTemp < 45) currentTemp++;
    } else {
        if (currentTemp > 15) currentTemp--;
    }
}
lastClk = clkState;
value = currentTemp;
]]></Service_Formula>
					<Service_NumberInputs>0</Service_NumberInputs>
